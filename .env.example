# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram to get the token
# Start a chat with your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates to get your chat_id
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# OpenRouter API Key (for V2 LLM features — optional)
OPENROUTER_API_KEY=your_openrouter_key_here
